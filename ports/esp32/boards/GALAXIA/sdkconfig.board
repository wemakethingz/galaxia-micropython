CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-galaxia.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions-galaxia.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_SPIRAM=n

# --- Reduire l'empreinte RAM du TLS (handshake SMTP SSL) ---
# Pas de DYNAMIC_BUFFER : incompatible avec les lectures octet-par-octet
# d'umail (read(3)/read(1)) -> pertes de donnees / timeout.
# A la place : buffer d'entree statique plus petit + on ne garde pas le
# certificat du serveur apres le handshake.
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192

# --- Reduire les buffers Wi-Fi pour liberer du tas ---
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# --- lwIP plus leger ---
CONFIG_LWIP_MAX_SOCKETS=6